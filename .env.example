# Resend (contact form delivery)
RESEND_API_KEY=
# Optional overrides
# CONTACT_TO_EMAIL=info@frontier-engineering.ai
# CONTACT_FROM_EMAIL=Frontier Engineering <website@send.frontier-engineering.ai>

# Benchmark registry (server-only; never prefix with NEXT_PUBLIC_). See research/README.md.
# Login role benchmarks_site (inherits benchmarks_reader) — used by the website. Read-only. Set locally and in Vercel.
# The site refuses to connect as any other role.
BENCHMARKS_SITE_DATABASE_URL=
# Login role that inherits benchmarks_writer — used by registry:import. Local only; never add it to Vercel.
BENCHMARKS_DATABASE_URL=
# Privileged connection for registry:migrate only. Keep it local; never add it to Vercel.
# BENCHMARKS_MIGRATION_URL=
